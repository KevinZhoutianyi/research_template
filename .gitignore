# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/

# uv
uv.lock

# Throwaway scratch (inside the repo so it stays visible; deletable at any time)
tmp/

# Keep small shared inputs tracked; ignore bulk storage and generated logs.
src/data/checkpoints/
src/data/datasets/
src/data/outputs/
src/slurm/logs/
src/.pytest_cache/
src/.ruff_cache/
*.pt
*.bin
*.safetensors
ckpts/
checkpoints/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Wandb
wandb/

# OS
.DS_Store

# Editor
.vscode/

# Vendored figure demos write into ./figures/ next to the script they ran from;
# the scripts are the reference, their outputs are not.
.claude/skills/scientific-figure-making/demos/*/figures/

# Personal Claude Code config — never tracked (permissions and notification hooks are per-user)
.claude/settings.local.json

# LaTeX build products (doc/paper/README.md promises these are ignored)
doc/paper/main.pdf
doc/paper/*.aux
doc/paper/*.log
doc/paper/*.out
doc/paper/*.bbl
doc/paper/*.blg
doc/paper/*.toc
*_overleaf.zip
