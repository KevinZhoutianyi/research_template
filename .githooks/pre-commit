#!/usr/bin/env bash
# Language gate on staged docs (root CLAUDE.md "Enforcement"). Runs the prose checks that
# otherwise rely on remembering to invoke the skill:
#   - check_prose.sh   on staged paper.md, proposal.md, doc/paper/*.tex
#   - check_language.sh on staged doc/weekly_updates/**/*.md (any report there, not just
#     update.md — the midterm report slipped through the narrower pattern; CLAUDE.md exempt)
# A hit blocks the commit; rewrite the flagged line (never allowlist). Emergency bypass:
# git commit --no-verify, and say so in the commit message.

set -u
ROOT=$(git rev-parse --show-toplevel)
CHECK_PROSE="$ROOT/.claude/skills/write-paper/scripts/check_prose.sh"
CHECK_LANG="$ROOT/.claude/skills/weekly-update/scripts/check_language.sh"

# Fail LOUDLY if a gate script is missing (a rename once made this hook a silent no-op).
for s in "$CHECK_PROSE" "$CHECK_LANG"; do
    if [ ! -x "$s" ]; then
        echo "pre-commit: gate script missing or not executable: $s" >&2
        echo "pre-commit: refusing to commit docs unchecked; fix the path in .githooks/pre-commit." >&2
        exit 1
    fi
done

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

# Check the STAGED content, not the working tree: materialize the staged blobs
# into a scratch dir so what is checked is exactly what is committed.
SCRATCH="$ROOT/tmp/precommit.$$"
trap 'rm -rf "$SCRATCH"' EXIT
stage_copy() {
    mkdir -p "$SCRATCH/$(dirname "$1")"
    git show ":$1" > "$SCRATCH/$1"
    echo "$SCRATCH/$1"
}

fail=0

prose_targets=$(grep -E '^doc/(paper\.md|proposal\.md|paper/.*\.tex)$' <<<"$staged" || true)
for f in $prose_targets; do
    "$CHECK_PROSE" "$(stage_copy "$f")" || fail=1
done

update_targets=$(grep -E '^doc/weekly_updates/.*\.md$' <<<"$staged" | grep -v 'CLAUDE\.md$' || true)
# Reports get both gates: check_language.sh (metaphors, self-justification) covers the
# report-specific bans; check_prose.sh covers the banned-word and AI-pattern lists that
# a long-form report (e.g. the midterm) needs just as much as the paper does.
for f in $update_targets; do
    staged_f=$(stage_copy "$f")
    "$CHECK_LANG" "$staged_f" || fail=1
    "$CHECK_PROSE" "$staged_f" || fail=1
done

if [ "$fail" -ne 0 ]; then
    echo ""
    echo "pre-commit: language gate failed on staged docs (rules: .claude/skills/write-paper/references/style.md)."
    echo "Rewrite the flagged lines, re-stage, and commit again."
fi
exit "$fail"
