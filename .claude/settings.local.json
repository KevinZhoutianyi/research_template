{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Skill(update-config)",
      "Skill(update-config:*)",
      "Read(*)",
      "WebFetch(domain:arxiv.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.semanticscholar.org)",
      "WebFetch(domain:html.duckduckgo.com)"
    ],
    "deny": [
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "curl -s -d 'Claude needs permission to edit a file' ntfy.sh/tzhou4-claude-x7k9z2 > /dev/null" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "curl -s -d 'Claude finished a task' ntfy.sh/tzhou4-claude-x7k9z2 > /dev/null" }
        ]
      }
    ]
  }
}
